---
import '../../../shared/playground.css'
import '../styles.css'
import VueLiquidDemo from '../components/VueLiquidDemo.vue'

export const prerender = true

const installExamples = {
  astro: `npm install @danixts/liquid-gooey

import { createLiquidGroup } from '@danixts/liquid-gooey'`,
  vue: `npm install @danixts/liquid-gooey vue

import { LiquidGroup, LiquidItem } from '@danixts/liquid-gooey/vue'`,
} as const

const variants = [
  { label: 'Action menu', family: 'morph', items: 3 },
  { label: 'Navigation pill', family: 'morph', items: 2 },
  { label: 'Spring button', family: 'move', items: 1 },
  { label: 'Floating action', family: 'move', items: 1 },
  { label: 'Dissolve badge', family: 'dissolve', items: 1 },
  { label: 'Search surface', family: 'morph', items: 2 },
] as const
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Liquid Gooey native TypeScript playground for Astro and Vue"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%238f7cff'/%3E%3Ccircle cx='24' cy='32' r='12' fill='white'/%3E%3Ccircle cx='43' cy='32' r='9' fill='white'/%3E%3C/svg%3E"
    />
    <title>Liquid Gooey playground</title>
  </head>
  <body>
    <main class="app">
      <nav class="top-links" aria-label="Project links">
        <button
          class="icon-button"
          type="button"
          data-theme-toggle
          aria-label="Toggle theme"
          title="Toggle theme"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            ><path
              d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.4-6.4L17 7m-10 10-1.4 1.4m12.8 0L17 17M7 7 5.6 5.6"
            ></path><circle cx="12" cy="12" r="4"></circle></svg
          ></button
        >
        <a
          class="icon-button"
          href="https://github.com/danixts/jakub-antalik"
          aria-label="GitHub"
          title="GitHub"
          ><svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 7.68a9.5 9.5 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.9c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path></svg
          ></a
        >
        <a
          class="icon-button"
          href="../beam/"
          aria-label="Border Beam playground"
          title="Border Beam"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            ><rect x="4" y="5" width="16" height="14" rx="4"></rect><path
              d="M8 9h8m-8 3h5"></path></svg
          ></a
        >
      </nav>

      <header class="hero">
        <div class="mark">
          <svg viewBox="0 0 32 32" fill="currentColor"
            ><circle cx="12" cy="16" r="7"></circle><circle
              cx="22"
              cy="16"
              r="5"></circle><path d="M15 12h6v8h-6z"></path></svg
          >
        </div>
        <h1>Liquid gooey</h1>
        <p class="subtitle">
          Morphing interfaces for native TypeScript, Astro, and Vue.
        </p>
        <p class="author-note">
          Original effect by <a href="https://github.com/Jakubantalik/Libraries"
            >Jakub Antalik</a
          > · independent native port
        </p>
      </header>

      <nav class="segmented family-tabs" aria-label="Effect family">
        <button type="button" data-family="morph" aria-selected="true"
          >Morph</button
        >
        <button type="button" data-family="move" aria-selected="false"
          >Move</button
        >
        <button type="button" data-family="dissolve" aria-selected="false"
          >Dissolve</button
        >
      </nav>

      <section class="example-stack" aria-label="Liquid Gooey examples">
        <div data-family-panel="morph">
          <div class="example-stack">
            <div class="example-cell example-cell--large">
              <div
                class="liquid-host liquid-host--menu"
                data-liquid-demo="morph"
              >
                <button
                  class="liquid-item liquid-item--small"
                  data-liquid-item
                  data-x="-76"
                  data-y="-45"
                  type="button">Image</button
                >
                <button
                  class="liquid-item liquid-item--small"
                  data-liquid-item
                  data-x="0"
                  data-y="-80"
                  type="button">Link</button
                >
                <button
                  class="liquid-item liquid-item--small"
                  data-liquid-item
                  data-x="76"
                  data-y="-45"
                  type="button">Note</button
                >
                <button
                  class="liquid-trigger"
                  type="button"
                  data-liquid-toggle
                  aria-expanded="true">Close</button
                >
              </div>
            </div>
            <div class="example-grid">
              <div class="example-cell">
                <div
                  class="liquid-host liquid-host--compact"
                  data-liquid-demo="shape"
                >
                  <button
                    class="liquid-item liquid-item--shape"
                    data-liquid-item
                    type="button">Morph</button
                  >
                </div>
              </div>
              <div class="example-cell">
                <div
                  class="liquid-host liquid-host--compact"
                  data-liquid-demo="pill"
                >
                  <button
                    class="liquid-item liquid-item--small"
                    data-liquid-item
                    data-x="-38"
                    type="button">All</button
                  ><button
                    class="liquid-item liquid-item--small"
                    data-liquid-item
                    data-x="38"
                    type="button">New</button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
        <div data-family-panel="move" hidden>
          <div class="example-stack">
            <div class="example-cell example-cell--large">
              <div
                class="liquid-host liquid-host--travel"
                data-liquid-demo="move"
              >
                <button
                  class="liquid-item liquid-item--move"
                  data-liquid-item
                  type="button">Send</button
                ><button class="stage-action" data-liquid-toggle type="button"
                  >Move across</button
                >
              </div>
            </div>
            <div class="example-grid">
              <div class="example-cell">
                <div
                  class="liquid-host liquid-host--compact"
                  data-liquid-demo="move-soft"
                >
                  <button
                    class="liquid-item liquid-item--move"
                    data-liquid-item
                    type="button">Soft</button
                  >
                </div>
              </div>
              <div class="example-cell">
                <div
                  class="liquid-host liquid-host--compact"
                  data-liquid-demo="move-bouncy"
                >
                  <button
                    class="liquid-item liquid-item--move"
                    data-liquid-item
                    type="button">Bounce</button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
        <div data-family-panel="dissolve" hidden>
          <div class="example-stack">
            <div class="example-cell example-cell--large">
              <div
                class="liquid-host liquid-host--travel"
                data-liquid-demo="dissolve"
              >
                <button
                  class="liquid-item liquid-item--dissolve"
                  data-liquid-item
                  type="button">Draft</button
                ><button class="stage-action" data-liquid-toggle type="button"
                  >Dissolve</button
                >
              </div>
            </div>
            <div class="example-grid">
              <div class="example-cell">
                <div
                  class="liquid-host liquid-host--compact"
                  data-liquid-demo="dissolve-soft"
                >
                  <button
                    class="liquid-item liquid-item--dissolve"
                    data-liquid-item
                    type="button">Soft</button
                  >
                </div>
              </div>
              <div class="example-cell">
                <div
                  class="liquid-host liquid-host--compact"
                  data-liquid-demo="dissolve-gravity"
                >
                  <button
                    class="liquid-item liquid-item--dissolve"
                    data-liquid-item
                    type="button">Gravity</button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="installation-title">
        <div class="section-heading">
          <h2 id="installation-title">Installation</h2><div class="segmented">
            <button type="button" data-code-target="astro" aria-selected="true"
              >Astro</button
            ><button type="button" data-code-target="vue" aria-selected="false"
              >Vue</button
            >
          </div>
        </div>
        <div class="code-block">
          <pre data-code="astro">{installExamples.astro}</pre><pre
            data-code="vue"
            hidden>{installExamples.vue}</pre><button
            class="copy-button"
            type="button"
            data-copy
            aria-label="Copy code"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              ><rect x="8" y="8" width="11" height="11" rx="2"></rect><path
                d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"
              ></path></svg
            ></button
          >
        </div>
      </section>

      <section class="section" aria-labelledby="playground-title">
        <div class="section-heading">
          <h2 id="playground-title">Playground</h2><p>
            One group, typed live options
          </p>
        </div>
        <div class="controls">
          <div class="control-row">
            <span class="control-label">Effect</span><div
              class="control-options"
              data-effect-options
            >
              <button type="button" data-value="morph" data-active="true"
                >morph</button
              ><button type="button" data-value="move" data-active="false"
                >move</button
              ><button type="button" data-value="dissolve" data-active="false"
                >dissolve</button
              >
            </div>
          </div>
          <label class="control-row"
            ><span class="control-label">Blur</span><span class="range-control"
              ><input
                type="range"
                min="3"
                max="16"
                step="1"
                value="8"
                data-range="blur"
              /><output>8px</output></span
            ></label
          >
          <label class="control-row"
            ><span class="control-label">Contrast</span><span
              class="range-control"
              ><input
                type="range"
                min="8"
                max="28"
                step="1"
                value="18"
                data-range="contrast"
              /><output>18</output></span
            ></label
          >
          <label class="control-row"
            ><span class="control-label">Distance</span><span
              class="range-control"
              ><input
                type="range"
                min="0"
                max="110"
                step="2"
                value="74"
                data-range="distance"
              /><output>74px</output></span
            ></label
          >
          <label class="control-row"
            ><span class="control-label">Strength</span><span
              class="range-control"
              ><input
                type="range"
                min="0"
                max="1"
                step="0.05"
                value="0.7"
                data-range="strength"
              /><output>0.70</output></span
            ></label
          >
        </div>
        <div class="playground-preview">
          <div class="preview-surface">
            <div
              class="liquid-host liquid-host--preview"
              data-playground-liquid
            >
              <button
                class="liquid-item liquid-item--preview"
                data-playground-item
                type="button">Astro</button
              >
            </div>
          </div><div class="preview-toolbar">
            <button
              class="preview-toggle"
              type="button"
              data-play-toggle
              aria-label="Run effect"
              ><svg viewBox="0 0 24 24" fill="currentColor"
                ><path d="m8 5 11 7-11 7V5Z"></path></svg
              ></button
            >
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="variants-title">
        <div class="section-heading">
          <h2 id="variants-title">Component variants</h2><p>
            Menus, pills, buttons, and surfaces
          </p>
        </div>
        <div class="variant-grid">
          {
            variants.map((variant) => (
              <div>
                <>
                  <div class="variant-card">
                    <div
                      class="variant-liquid"
                      data-variant-liquid
                      data-family={variant.family}
                    >
                      {Array.from({ length: variant.items }, (_, index) => (
                        <button
                          class:list={[
                            'variant-blob',
                            `variant-blob--${variant.family}`,
                          ]}
                          data-liquid-item
                          data-index={index}
                          type="button"
                        >
                          {variant.items > 1 ? index + 1 : variant.family}
                        </button>
                      ))}
                    </div>
                  </div>
                  <p class="variant-label">{variant.label}</p>
                </>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="integration-title">
        <div class="section-heading">
          <h2 id="integration-title">Native Astro and Vue</h2><p>
            Shared TypeScript engine
          </p>
        </div>
        <div class="integration-grid">
          <article class="integration-card">
            <h3>Astro</h3><p>
              Mount native DOM controllers from a processed TypeScript script
              with zero framework runtime.
            </p>
          </article><article class="integration-card">
            <h3>Vue 3</h3><p>
              Compose LiquidGroup and LiquidItem with reactive typed props and
              automatic lifecycle cleanup.
            </p>
          </article>
        </div>
        <div class="vue-surface"><VueLiquidDemo client:visible /></div>
      </section>

      <footer class="footer">
        Independent TypeScript port · Original Liquid Gooey by <a
          href="https://github.com/Jakubantalik/Libraries">Jakub Antalik</a
        >
      </footer>
    </main>

    <script>
      import {
        createLiquidGroup,
        type LiquidGroupController,
        type LiquidItemController,
        type LiquidItemOptions,
      } from '@danixts/liquid-gooey'

      type PlaygroundEffect = 'morph' | 'move' | 'dissolve'
      interface MountedGroup {
        group: LiquidGroupController
        items: LiquidItemController[]
      }

      let mounted: MountedGroup[] = []
      let playground: MountedGroup | undefined
      let abort: AbortController | undefined
      let effect: PlaygroundEffect = 'morph'
      let distance = 74
      let strength = 0.7
      let playgroundOpen = false
      let theme: 'dark' | 'light' = 'dark'

      const mountGroup = (
        element: HTMLElement,
        options: Parameters<typeof createLiquidGroup>[1] = {},
      ): MountedGroup => {
        const group = createLiquidGroup(element, {
          blur: 8,
          contrast: 18,
          fill: '#8f7cff',
          ...options,
        })
        const items = Array.from(
          element.querySelectorAll<HTMLElement>('[data-liquid-item]'),
        ).map((item, index) =>
          group.add(item, {
            x: Number(item.dataset.x ?? 0),
            y: Number(item.dataset.y ?? 0),
            transition: 'bouncy',
            delay: index * 28,
          }),
        )
        return { group, items }
      }

      const playgroundOptions = (): LiquidItemOptions => {
        const position = playgroundOpen ? distance : -distance
        if (effect === 'move')
          return {
            effect: 'move',
            x: position,
            move: {
              springiness: strength,
              wobble: strength,
              stretch: strength,
              trail: strength,
            },
            transition: 'bouncy',
          }
        if (effect === 'dissolve')
          return {
            x: position,
            scale: playgroundOpen ? 0.72 : 1,
            dissolve: {
              active: true,
              strength,
              warp: 28,
              gravity: 65,
              flowSpeed: 22,
            },
            transition: 'smooth',
          }
        return {
          x: position,
          morph: { shape: true, speed: 0.8 + strength * 0.6, bounce: strength },
          transition: 'bouncy',
        }
      }

      const mount = (): void => {
        abort?.abort()
        abort = new AbortController()
        const { signal } = abort
        mounted.forEach(({ group }) => group.destroy())
        playground?.group.destroy()
        mounted = []

        document
          .querySelectorAll<HTMLElement>('[data-liquid-demo]')
          .forEach((element) => {
            const kind = element.dataset.liquidDemo
            const entry = mountGroup(element, {
              fill: kind?.includes('dissolve')
                ? '#6d8cff'
                : kind?.includes('move')
                  ? '#ff9a55'
                  : '#8f7cff',
            })
            mounted.push(entry)
            const item = entry.items[0]
            if (kind === 'shape')
              item?.update({ morph: { shape: true, speed: 1.1, bounce: 0.65 } })
            if (kind?.startsWith('move'))
              item?.update({
                effect: 'move',
                x: kind === 'move' ? -86 : -42,
                move: {
                  springiness: 0.75,
                  wobble: 0.7,
                  stretch: 0.68,
                  trail: 0.7,
                },
              })
            if (kind?.startsWith('dissolve'))
              item?.update({
                x: kind === 'dissolve' ? -78 : 0,
                dissolve: {
                  active: true,
                  strength: kind === 'dissolve-gravity' ? 1 : 0.45,
                  gravity: kind === 'dissolve-gravity' ? 90 : 45,
                },
              })
          })

        document
          .querySelectorAll<HTMLElement>('[data-variant-liquid]')
          .forEach((element) => {
            const family = element.dataset.family as PlaygroundEffect
            const entry = mountGroup(element, {
              blur: 7,
              contrast: 17,
              fill:
                family === 'move'
                  ? '#ff9a55'
                  : family === 'dissolve'
                    ? '#6d8cff'
                    : '#8f7cff',
            })
            entry.items.forEach((item, index) =>
              item.update(
                family === 'move'
                  ? { effect: 'move', x: -26, move: { wobble: 0.6 } }
                  : family === 'dissolve'
                    ? { dissolve: 0.6 }
                    : {
                        x: (index - (entry.items.length - 1) / 2) * 36,
                        morph: { shape: true },
                      },
              ),
            )
            mounted.push(entry)
          })

        const playgroundElement = document.querySelector<HTMLElement>(
          '[data-playground-liquid]',
        )
        if (playgroundElement) {
          playground = mountGroup(playgroundElement)
          playground.items[0]?.update(playgroundOptions())
        }

        document.addEventListener(
          'click',
          (event) => {
            const target =
              event.target instanceof Element
                ? event.target.closest<HTMLButtonElement>('button')
                : null
            if (!target) return

            if (target.dataset.family) {
              document
                .querySelectorAll<HTMLButtonElement>('[data-family]')
                .forEach((button) =>
                  button.setAttribute(
                    'aria-selected',
                    String(button === target),
                  ),
                )
              document
                .querySelectorAll<HTMLElement>('[data-family-panel]')
                .forEach((panel) => {
                  panel.hidden =
                    panel.dataset.familyPanel !== target.dataset.family
                })
            }

            if (target.dataset.codeTarget) {
              document
                .querySelectorAll<HTMLButtonElement>('[data-code-target]')
                .forEach((button) =>
                  button.setAttribute(
                    'aria-selected',
                    String(button === target),
                  ),
                )
              document
                .querySelectorAll<HTMLElement>('[data-code]')
                .forEach((code) => {
                  code.hidden = code.dataset.code !== target.dataset.codeTarget
                })
            }

            if (
              target.closest('[data-effect-options]') &&
              target.dataset.value
            ) {
              effect = target.dataset.value as PlaygroundEffect
              target.parentElement
                ?.querySelectorAll<HTMLButtonElement>('button')
                .forEach((button) => {
                  button.dataset.active = String(button === target)
                })
              playground?.items[0]?.update(playgroundOptions())
            }

            const host = target.closest<HTMLElement>('[data-liquid-demo]')
            if (host && target.matches('[data-liquid-toggle]')) {
              const index = Array.from(
                document.querySelectorAll('[data-liquid-demo]'),
              ).indexOf(host)
              const entry = mounted[index]
              const isOpen = target.getAttribute('aria-expanded') !== 'false'
              if (host.dataset.liquidDemo === 'morph') {
                entry?.items.forEach((item, itemIndex) =>
                  item.update(
                    isOpen
                      ? { x: 0, y: 0, delay: itemIndex * 24 }
                      : {
                          x: Number(
                            host.querySelectorAll<HTMLElement>(
                              '[data-liquid-item]',
                            )[itemIndex]?.dataset.x ?? 0,
                          ),
                          y: Number(
                            host.querySelectorAll<HTMLElement>(
                              '[data-liquid-item]',
                            )[itemIndex]?.dataset.y ?? 0,
                          ),
                          delay: itemIndex * 24,
                        },
                  ),
                )
                target.setAttribute('aria-expanded', String(!isOpen))
                target.textContent = isOpen ? 'Open' : 'Close'
              } else if (host.dataset.liquidDemo === 'move') {
                entry?.items[0]?.update({
                  effect: 'move',
                  x: target.dataset.open === 'true' ? -86 : 86,
                  transition: 'bouncy',
                })
                target.dataset.open = String(target.dataset.open !== 'true')
              } else if (host.dataset.liquidDemo === 'dissolve') {
                const open = target.dataset.open !== 'true'
                entry?.items[0]?.update({
                  x: open ? 78 : -78,
                  scale: open ? 0.7 : 1,
                  dissolve: {
                    active: true,
                    strength: open ? 1 : 0.35,
                    warp: 30,
                    gravity: 72,
                  },
                  transition: 'smooth',
                })
                target.dataset.open = String(open)
              }
            }

            if (target.matches('[data-play-toggle]')) {
              playgroundOpen = !playgroundOpen
              playground?.items[0]?.update(playgroundOptions())
            }

            if (target.matches('[data-theme-toggle]')) {
              theme = theme === 'dark' ? 'light' : 'dark'
              document.documentElement.dataset.theme = theme
            }

            if (target.matches('[data-copy]')) {
              const value = target.parentElement?.querySelector<HTMLElement>(
                '[data-code]:not([hidden])',
              )?.textContent
              if (value) void navigator.clipboard.writeText(value)
            }
          },
          { signal },
        )

        document.addEventListener(
          'input',
          (event) => {
            if (
              !(event.target instanceof HTMLInputElement) ||
              !event.target.dataset.range
            )
              return
            const key = event.target.dataset.range
            const value = Number(event.target.value)
            const output =
              event.target.parentElement?.querySelector<HTMLOutputElement>(
                'output',
              )
            if (key === 'blur' || key === 'contrast')
              playground?.group.update({ [key]: value })
            if (key === 'distance') distance = value
            if (key === 'strength') strength = value
            if (key === 'distance' || key === 'strength')
              playground?.items[0]?.update(playgroundOptions())
            if (output)
              output.value =
                key === 'strength'
                  ? value.toFixed(2)
                  : key === 'contrast'
                    ? String(value)
                    : `${value}px`
          },
          { signal },
        )
      }

      mount()
      document.addEventListener(
        'astro:before-swap',
        () => {
          abort?.abort()
          mounted.forEach(({ group }) => group.destroy())
          playground?.group.destroy()
        },
        { once: true },
      )
    </script>
  </body>
</html>
